# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# 카카오 (회원 탈퇴 시 앱 연결 해제)
# Kakao Developers → 앱 설정 → 앱 키 → Admin 키.
KAKAO_ADMIN_KEY=

# Gemini — Vertex(Gemini Enterprise Agent Platform) 전용. GCP 프로젝트 + 서비스 계정 키.
#     인증은 키 문자열이 아니라 키 "파일" — 아래 세 줄이 세트다.
GCP_PROJECT_ID=

# Gemini 3.x 는 global 에서만 뜬다. 2.5 계열만 쓸 때만 리전을 바꿀 이유가 있다.
GCP_LOCATION=global

# 서비스 계정 키 파일 경로. 키 문자열이 아니라 파일 경로다.
GOOGLE_APPLICATION_CREDENTIALS=app/core/credentials/<서비스계정키>.json

# 모델명 기본값은 app/core/config.py에 있음. 바꿀 때만 지정.
# GEMINI_MODEL=

# Product comparison
# PRODUCT_COMPARE_MAX_COUNT=4

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
