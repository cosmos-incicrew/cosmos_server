# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 (회원 탈퇴 시 앱 연결 해제)
# Kakao Developers → 앱 설정 → 앱 키 → Admin 키.
KAKAO_ADMIN_KEY=

# Gemini — 로컬에서는 아래 둘 중 하나만 채운다.
#
# (A) AI Studio: API 키 방식. 세팅이 간단하고 무료 티어가 있다.
GEMINI_API_KEY=
#
# (B) Vertex: GCP 프로젝트 방식. 배포 환경은 이 방식을 쓴다.
#     GCP_PROJECT_ID 를 채우면 A 를 무시하고 이쪽으로 붙는다.
#     GCE에서는 VM 서비스 계정 ADC를 사용하므로 키 파일을 지정하지 않는다.
# GCP_PROJECT_ID=kt-tech-up-01

# Gemini 3.x 는 global 에서만 뜬다. 2.5 계열만 쓸 때만 리전을 바꿀 이유가 있다.
# GCP_LOCATION=global

# 로컬 Vertex 개발은 `gcloud auth application-default login`을 사용한다.
# GCE와 GitHub Actions에서는 이 값을 설정하지 않는다.

# 모델명 기본값은 app/core/config.py에 있음. 바꿀 때만 지정.
# GEMINI_MODEL_FLASH=
# GEMINI_MODEL_PRO=

# Product comparison
# PRODUCT_COMPARE_MAX_COUNT=4

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_TRACING_RELEASE=local
# 테스트와 CI에서만 false로 설정한다.
# LANGFUSE_TRACING_ENABLED=true
