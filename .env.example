# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 (회원 탈퇴 시 앱 연결 해제)
# Kakao Developers → 앱 설정 → 앱 키 → Admin 키.
KAKAO_ADMIN_KEY=

# Gemini — Vertex AI 전용. 로컬에서는 `gcloud auth application-default login`,
# GCE에서는 VM 서비스 계정의 Application Default Credentials를 사용한다.
GCP_PROJECT_ID=

# Gemini 3.x 는 global 에서만 뜬다. 2.5 계열만 쓸 때만 리전을 바꿀 이유가 있다.
GCP_LOCATION=global

# 모델명 기본값은 app/core/config.py에 있음. 바꿀 때만 지정.
# GEMINI_MODEL=

# Product comparison
# PRODUCT_COMPARE_MAX_COUNT=4

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_TRACING_RELEASE=local
# 테스트와 CI에서만 false로 설정한다.
# LANGFUSE_TRACING_ENABLED=true
